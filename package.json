{
  "name": "forgecode",
  "version": "0.1.0",
  "description": "Local-first autonomous coding agent — Claude Code for LM Studio, Ollama & llama.cpp with hardware-aware parallel sub-agents",
  "keywords": [
    "ai",
    "coding-agent",
    "autonomous-agent",
    "lm-studio",
    "ollama",
    "llama.cpp",
    "local-llm",
    "local-first",
    "claude-code",
    "codex",
    "sub-agents",
    "parallel-agents",
    "dev-tools",
    "llm",
    "openai-compatible",
    "hardware-aware",
    "agentic",
    "code-generation",
    "developer-tools"
  ],
  "author": "ForgeCode Contributors",
  "license": "MIT",
  "type": "module",
  "bin": {
    "forge": "./dist/cli/index.js",
    "forgecode": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "prepare": "npm run build",
    "docs:serve": "npx serve docs",
    "doctor": "node dist/cli/index.js doctor"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "inquirer": "^9.2.15",
    "zod": "^3.23.8",
    "openai": "^4.72.0",
    "fast-glob": "^3.3.2",
    "ignore": "^7.0.0",
    "tiny-queue": "^0.2.1",
    "p-limit": "^5.0.0",
    "systeminformation": "^5.21.13"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/inquirer": "^9.0.7",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3",
    "eslint": "^9.11.0",
    "prettier": "^3.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fthsrbst/forgecode.git"
  },
  "homepage": "https://fthsrbst.github.io/forgecode",
  "bugs": {
    "url": "https://github.com/fthsrbst/forgecode/issues"
  }
}
